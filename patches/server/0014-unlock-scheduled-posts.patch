@@ -772 +772,36 @@ func TestHandleFailedScheduledPosts(t *testing.T) {
 }
+
+func TestProcessScheduledPostsWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	th.App.Srv().SetLicense(nil)
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.ScheduledPosts = true })
+
+	scheduledPost := &model.ScheduledPost{
+		Draft: model.Draft{
+			CreateAt:  model.GetMillis(),
+			UserId:    th.BasicUser.Id,
+			ChannelId: th.BasicChannel.Id,
+			Message:   "due scheduled post without a licence",
+		},
+		ScheduledAt: model.GetMillis() - 1000,
+	}
+	_, err := th.Server.Store().ScheduledPost().CreateScheduledPost(th.Context, scheduledPost)
+	require.NoError(t, err)
+
+	th.App.ProcessScheduledPosts(th.Context)
+
+	pending, err := th.App.Srv().Store().ScheduledPost().GetScheduledPostsForUser(th.Context, th.BasicUser.Id, th.BasicChannel.TeamId)
+	require.NoError(t, err)
+	require.Empty(t, pending, "the due post is sent and removed")
+
+	posts, appErr := th.App.GetPostsPage(th.Context, model.GetPostsOptions{ChannelId: th.BasicChannel.Id, Page: 0, PerPage: 10})
+	require.Nil(t, appErr)
+	var found bool
+	for _, p := range posts.Posts {
+		if p.Message == "due scheduled post without a licence" {
+			found = true
+		}
+	}
+	require.True(t, found, "the scheduled message was published to the channel")
+}
